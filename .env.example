# Development-only defaults. Never commit a populated .env file.
OPTIMIZER_ENVIRONMENT=development
OPTIMIZER_LOG_LEVEL=INFO
OPTIMIZER_POLICY_VERSION=bootstrap-v1
OPTIMIZER_DATABASE_DSN=postgresql://optimizer:change-me@localhost:5432/optimizer
OPTIMIZER_ARTIFACT_ENDPOINT=http://localhost:9000
OPTIMIZER_ARTIFACT_BUCKET=optimizer-development
OPTIMIZER_ARTIFACT_ACCESS_KEY=optimizer
OPTIMIZER_ARTIFACT_SECRET_KEY=change-me-now
OPTIMIZER_POLICY_URL=http://localhost:8181
OPTIMIZER_OTEL_ENDPOINT=http://localhost:4317
# Optional: each only required to run its own tests/integration/test_*_model_provider*.py
# smoke test (skipped automatically when unset) and to construct the matching
# ModelProviderPort adapter (adapters/production/*_model_provider.py).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL_ID=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_ID=deepseek-chat
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-2.5-flash
# No key needed for Ollama/local servers; override the endpoint/model if not
# running on defaults (OllamaModelProvider also accepts these as constructor args).
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL_ID=llama3.2

# Development tags only. Production manifests must use approved image digests.
POSTGRES_IMAGE=postgres:17.6-alpine
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_MC_IMAGE=quay.io/minio/mc:RELEASE.2025-04-16T18-13-26Z
OPA_IMAGE=openpolicyagent/opa:1.7.1-static
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.133.0
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0

