{
  "$defs": {
    "ProducerIdentity": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ProducerIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actor_id": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Actor Id",
      "type": "string"
    },
    "actor_role": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Actor Role",
      "type": "string"
    },
    "allowed_root": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Allowed Root",
      "type": "string"
    },
    "artifact_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_type": {
      "const": "IntakeEnvelope",
      "default": "IntakeEnvelope",
      "title": "Artifact Type",
      "type": "string"
    },
    "case_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "content_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Digest",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "extensions": {
      "additionalProperties": true,
      "title": "Extensions",
      "type": "object"
    },
    "input_mode": {
      "enum": [
        "raw",
        "structured",
        "mixed"
      ],
      "title": "Input Mode",
      "type": "string"
    },
    "local_path": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Local Path",
      "type": "string"
    },
    "original_payload_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Original Payload Digest",
      "type": "string"
    },
    "parent_digests": {
      "items": {
        "type": "string"
      },
      "title": "Parent Digests",
      "type": "array"
    },
    "policy_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Policy Versions",
      "type": "object"
    },
    "producer": {
      "$ref": "#/$defs/ProducerIdentity"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "artifact_id",
    "tenant_id",
    "case_id",
    "created_at",
    "producer",
    "content_digest",
    "input_mode",
    "actor_id",
    "actor_role",
    "local_path",
    "allowed_root",
    "original_payload_digest"
  ],
  "title": "IntakeEnvelope",
  "type": "object"
}
