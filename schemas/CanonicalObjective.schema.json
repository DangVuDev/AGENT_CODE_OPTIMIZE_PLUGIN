{
  "$defs": {
    "Objective": {
      "additionalProperties": false,
      "properties": {
        "feature_id": {
          "minLength": 1,
          "title": "Feature Id",
          "type": "string"
        },
        "statement": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "statement",
        "feature_id"
      ],
      "title": "Objective",
      "type": "object"
    },
    "ProducerIdentity": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ProducerIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_type": {
      "const": "CanonicalObjective",
      "default": "CanonicalObjective",
      "title": "Artifact Type",
      "type": "string"
    },
    "case_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "content_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Digest",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "extensions": {
      "additionalProperties": true,
      "title": "Extensions",
      "type": "object"
    },
    "missing_fields": {
      "items": {
        "type": "string"
      },
      "title": "Missing Fields",
      "type": "array"
    },
    "objective": {
      "anyOf": [
        {
          "$ref": "#/$defs/Objective"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "parent_digests": {
      "items": {
        "type": "string"
      },
      "title": "Parent Digests",
      "type": "array"
    },
    "policy_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Policy Versions",
      "type": "object"
    },
    "producer": {
      "$ref": "#/$defs/ProducerIdentity"
    },
    "requester_hypothesis": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requester Hypothesis"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "artifact_id",
    "tenant_id",
    "case_id",
    "created_at",
    "producer",
    "content_digest"
  ],
  "title": "CanonicalObjective",
  "type": "object"
}
