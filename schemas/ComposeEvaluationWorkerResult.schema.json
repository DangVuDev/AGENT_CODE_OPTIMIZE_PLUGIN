{
  "$defs": {
    "EvaluationAttemptResult": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "evaluation_id": {
          "minLength": 1,
          "title": "Evaluation Id",
          "type": "string"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "output": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvaluationOutput"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "repetition": {
          "minimum": 1,
          "title": "Repetition",
          "type": "integer"
        },
        "stderr": {
          "default": "",
          "title": "Stderr",
          "type": "string"
        },
        "stdout": {
          "default": "",
          "title": "Stdout",
          "type": "string"
        }
      },
      "required": [
        "evaluation_id",
        "repetition",
        "exit_code"
      ],
      "title": "EvaluationAttemptResult",
      "type": "object"
    },
    "EvaluationOutput": {
      "additionalProperties": false,
      "description": "The only accepted stdout payload from a product evaluator.",
      "properties": {
        "artifacts": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Artifacts",
          "type": "object"
        },
        "feature_id": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Feature Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "metrics": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "minProperties": 1,
          "title": "Metrics",
          "type": "object"
        },
        "samples": {
          "additionalProperties": {
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "array"
          },
          "title": "Samples",
          "type": "object"
        },
        "schema_version": {
          "default": "1.0",
          "maxLength": 32,
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "feature_id",
        "metrics"
      ],
      "title": "EvaluationOutput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempts": {
      "items": {
        "$ref": "#/$defs/EvaluationAttemptResult"
      },
      "title": "Attempts",
      "type": "array"
    },
    "cleanup_confirmed": {
      "title": "Cleanup Confirmed",
      "type": "boolean"
    },
    "lifecycle_error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lifecycle Error"
    },
    "project_name": {
      "minLength": 1,
      "title": "Project Name",
      "type": "string"
    }
  },
  "required": [
    "project_name",
    "cleanup_confirmed"
  ],
  "title": "ComposeEvaluationWorkerResult",
  "type": "object"
}
