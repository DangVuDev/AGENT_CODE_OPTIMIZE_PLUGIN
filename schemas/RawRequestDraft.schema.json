{
  "$defs": {
    "CriterionInput": {
      "additionalProperties": false,
      "description": "One requester-declared optimization criterion, before A1.61\ncanonicalizes it into a real `Criterion`.\n\n`weight` is the requester's own priority between criteria and is the only\nthing that orders them: S01.40 normalizes every weight against their sum\n(`weight / total_weight`) before scoring, so what matters is each\ncriterion's share, not its absolute value or its position in the list.",
      "properties": {
        "direction": {
          "enum": [
            "minimize",
            "maximize",
            "target"
          ],
          "title": "Direction",
          "type": "string"
        },
        "metric_id": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "target": {
          "minimum": 0,
          "title": "Target",
          "type": "number"
        },
        "unit": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "weight": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "metric_id",
        "direction",
        "target",
        "unit"
      ],
      "title": "CriterionInput",
      "type": "object"
    },
    "Origin": {
      "enum": [
        "manual",
        "automatic"
      ],
      "title": "Origin",
      "type": "string"
    },
    "ProducerIdentity": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ProducerIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_type": {
      "const": "RawRequestDraft",
      "default": "RawRequestDraft",
      "title": "Artifact Type",
      "type": "string"
    },
    "case_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "commands": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "enum": [
              "build",
              "lint",
              "type",
              "unit"
            ]
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Commands"
    },
    "conflicts": {
      "items": {
        "type": "string"
      },
      "title": "Conflicts",
      "type": "array"
    },
    "content_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Digest",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "criteria": {
      "items": {
        "$ref": "#/$defs/CriterionInput"
      },
      "maxItems": 32,
      "title": "Criteria",
      "type": "array"
    },
    "dataset_id": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dataset Id"
    },
    "direction": {
      "anyOf": [
        {
          "enum": [
            "minimize",
            "maximize",
            "target"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Direction"
    },
    "environment_id": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Environment Id"
    },
    "extensions": {
      "additionalProperties": true,
      "title": "Extensions",
      "type": "object"
    },
    "extraction_confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Extraction Confidence",
      "type": "number"
    },
    "feature_id": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Feature Id"
    },
    "field_provenance": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Field Provenance",
      "type": "object"
    },
    "guardrail_metric_id": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Guardrail Metric Id"
    },
    "metric_id": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Metric Id"
    },
    "objective_statement": {
      "anyOf": [
        {
          "maxLength": 4000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Objective Statement"
    },
    "origin": {
      "$ref": "#/$defs/Origin"
    },
    "parent_digests": {
      "items": {
        "type": "string"
      },
      "title": "Parent Digests",
      "type": "array"
    },
    "policy_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Policy Versions",
      "type": "object"
    },
    "producer": {
      "$ref": "#/$defs/ProducerIdentity"
    },
    "requester_hypothesis": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requester Hypothesis"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "target": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target"
    },
    "tenant_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    },
    "unit": {
      "anyOf": [
        {
          "maxLength": 100,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit"
    },
    "unresolved_fields": {
      "items": {
        "type": "string"
      },
      "title": "Unresolved Fields",
      "type": "array"
    },
    "workload_id": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workload Id"
    }
  },
  "required": [
    "artifact_id",
    "tenant_id",
    "case_id",
    "created_at",
    "producer",
    "content_digest",
    "origin",
    "extraction_confidence"
  ],
  "title": "RawRequestDraft",
  "type": "object"
}
