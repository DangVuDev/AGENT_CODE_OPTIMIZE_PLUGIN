{
  "additionalProperties": false,
  "description": "One repository-owned command executed inside a Compose service.",
  "properties": {
    "argv": {
      "items": {
        "type": "string"
      },
      "maxItems": 128,
      "minItems": 1,
      "title": "Argv",
      "type": "array"
    },
    "service": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.-]+$",
      "title": "Service",
      "type": "string"
    },
    "timeout_seconds": {
      "default": 300,
      "exclusiveMinimum": 0,
      "maximum": 86400,
      "title": "Timeout Seconds",
      "type": "integer"
    },
    "working_directory": {
      "anyOf": [
        {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Working Directory"
    }
  },
  "required": [
    "service",
    "argv"
  ],
  "title": "ContainerCommandSpec",
  "type": "object"
}
