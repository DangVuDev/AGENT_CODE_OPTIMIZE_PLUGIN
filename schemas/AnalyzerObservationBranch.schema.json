{
  "$defs": {
    "AnalyzerObservation": {
      "additionalProperties": false,
      "properties": {
        "analyzer": {
          "minLength": 1,
          "title": "Analyzer",
          "type": "string"
        },
        "analyzer_version": {
          "minLength": 1,
          "title": "Analyzer Version",
          "type": "string"
        },
        "coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Coverage",
          "type": "number"
        },
        "description": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "files": {
          "items": {
            "type": "string"
          },
          "title": "Files",
          "type": "array"
        },
        "observation_id": {
          "minLength": 1,
          "title": "Observation Id",
          "type": "string"
        },
        "polarity": {
          "enum": [
            "positive",
            "negative"
          ],
          "title": "Polarity",
          "type": "string"
        },
        "problem_signal_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Problem Signal Ids",
          "type": "array"
        },
        "source": {
          "enum": [
            "syntax",
            "semantic",
            "domain",
            "runtime"
          ],
          "title": "Source",
          "type": "string"
        },
        "symbols": {
          "items": {
            "type": "string"
          },
          "title": "Symbols",
          "type": "array"
        }
      },
      "required": [
        "observation_id",
        "source",
        "analyzer",
        "analyzer_version",
        "problem_signal_ids",
        "description",
        "polarity",
        "coverage"
      ],
      "title": "AnalyzerObservation",
      "type": "object"
    },
    "ProducerIdentity": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ProducerIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Shared fan-out shape for A3.30-A3.33 — same pattern as A2's\n`BranchEvidenceRefs`: one schema, `branch_id`/`source` differentiate.\n\n`unavailable_reason` set + empty `observations` is a legitimate result\n(e.g. A3.32 with no registered domain analyzer, A3.33 with no telemetry\nevidence to correlate), not a stub.",
  "properties": {
    "artifact_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_type": {
      "const": "AnalyzerObservationBranch",
      "default": "AnalyzerObservationBranch",
      "title": "Artifact Type",
      "type": "string"
    },
    "branch_id": {
      "pattern": "^A3\\.3[0-3]$",
      "title": "Branch Id",
      "type": "string"
    },
    "case_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "content_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Digest",
      "type": "string"
    },
    "coverage_gaps": {
      "items": {
        "type": "string"
      },
      "title": "Coverage Gaps",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "extensions": {
      "additionalProperties": true,
      "title": "Extensions",
      "type": "object"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/AnalyzerObservation"
      },
      "title": "Observations",
      "type": "array"
    },
    "parent_digests": {
      "items": {
        "type": "string"
      },
      "title": "Parent Digests",
      "type": "array"
    },
    "policy_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Policy Versions",
      "type": "object"
    },
    "producer": {
      "$ref": "#/$defs/ProducerIdentity"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "enum": [
        "syntax",
        "semantic",
        "domain",
        "runtime"
      ],
      "title": "Source",
      "type": "string"
    },
    "tenant_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    },
    "unavailable_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unavailable Reason"
    }
  },
  "required": [
    "artifact_id",
    "tenant_id",
    "case_id",
    "created_at",
    "producer",
    "content_digest",
    "branch_id",
    "source"
  ],
  "title": "AnalyzerObservationBranch",
  "type": "object"
}
