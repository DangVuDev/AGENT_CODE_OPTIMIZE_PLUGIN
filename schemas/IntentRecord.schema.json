{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Compact pointer allowed in graph state; never embeds raw artifact data.",
      "properties": {
        "artifact_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Artifact Type",
          "type": "string"
        },
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "schema_version": {
          "pattern": "^[1-9][0-9]*\\.[0-9]+$",
          "title": "Schema Version",
          "type": "string"
        },
        "uri": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "artifact_type",
        "schema_version",
        "artifact_id",
        "content_digest",
        "uri"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "IntentStatus": {
      "enum": [
        "pending",
        "completed",
        "unknown",
        "failed"
      ],
      "title": "IntentStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "idempotency_key": {
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "input_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Input Digest",
      "type": "string"
    },
    "node_id": {
      "minLength": 1,
      "title": "Node Id",
      "type": "string"
    },
    "output_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status": {
      "$ref": "#/$defs/IntentStatus"
    },
    "tenant_id": {
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "idempotency_key",
    "node_id",
    "case_id",
    "status",
    "input_digest",
    "updated_at"
  ],
  "title": "IntentRecord",
  "type": "object"
}
