{
  "additionalProperties": false,
  "description": "Compact pointer allowed in graph state; never embeds raw artifact data.",
  "properties": {
    "artifact_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_type": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Artifact Type",
      "type": "string"
    },
    "content_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Digest",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^[1-9][0-9]*\\.[0-9]+$",
      "title": "Schema Version",
      "type": "string"
    },
    "uri": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Uri",
      "type": "string"
    }
  },
  "required": [
    "artifact_type",
    "schema_version",
    "artifact_id",
    "content_digest",
    "uri"
  ],
  "title": "ArtifactRef",
  "type": "object"
}
