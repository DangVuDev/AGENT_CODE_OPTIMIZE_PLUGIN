{
  "$defs": {
    "ComposeExecutionContract": {
      "additionalProperties": false,
      "description": "Immutable A1-to-A2 handoff for isolated product evaluation.",
      "properties": {
        "application_services": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Application Services",
          "type": "array"
        },
        "cleanup_timeout_seconds": {
          "default": 60,
          "exclusiveMinimum": 0,
          "maximum": 600,
          "title": "Cleanup Timeout Seconds",
          "type": "integer"
        },
        "compose_file": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Compose File",
          "type": "string"
        },
        "evaluations": {
          "items": {
            "$ref": "#/$defs/EvaluationSpec"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Evaluations",
          "type": "array"
        },
        "startup_timeout_seconds": {
          "default": 180,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Startup Timeout Seconds",
          "type": "integer"
        }
      },
      "required": [
        "compose_file",
        "evaluations"
      ],
      "title": "ComposeExecutionContract",
      "type": "object"
    },
    "ContainerCommandSpec": {
      "additionalProperties": false,
      "description": "One repository-owned command executed inside a Compose service.",
      "properties": {
        "argv": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Argv",
          "type": "array"
        },
        "service": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Service",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 300,
          "exclusiveMinimum": 0,
          "maximum": 86400,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "working_directory": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Working Directory"
        }
      },
      "required": [
        "service",
        "argv"
      ],
      "title": "ContainerCommandSpec",
      "type": "object"
    },
    "EvaluationSpec": {
      "additionalProperties": false,
      "description": "Repeatable evaluator and the metric names it promises to emit.",
      "properties": {
        "command": {
          "$ref": "#/$defs/ContainerCommandSpec"
        },
        "evaluation_id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Evaluation Id",
          "type": "string"
        },
        "expected_metric_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Expected Metric Ids",
          "type": "array",
          "uniqueItems": true
        },
        "repetitions": {
          "default": 1,
          "maximum": 100,
          "minimum": 1,
          "title": "Repetitions",
          "type": "integer"
        },
        "warmup_runs": {
          "default": 0,
          "maximum": 50,
          "minimum": 0,
          "title": "Warmup Runs",
          "type": "integer"
        }
      },
      "required": [
        "evaluation_id",
        "command",
        "expected_metric_ids"
      ],
      "title": "EvaluationSpec",
      "type": "object"
    },
    "ProducerIdentity": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ProducerIdentity",
      "type": "object"
    },
    "WorkloadContract": {
      "additionalProperties": false,
      "properties": {
        "cache_state": {
          "minLength": 1,
          "title": "Cache State",
          "type": "string"
        },
        "commands": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "propertyNames": {
                "enum": [
                  "build",
                  "lint",
                  "type",
                  "unit"
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commands"
        },
        "concurrency": {
          "minimum": 1,
          "title": "Concurrency",
          "type": "integer"
        },
        "dataset_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Digest"
        },
        "dataset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Id"
        },
        "environment_id": {
          "minLength": 1,
          "title": "Environment Id",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "protocol_version": {
          "default": "1.0",
          "minLength": 1,
          "title": "Protocol Version",
          "type": "string"
        },
        "repetitions": {
          "minimum": 1,
          "title": "Repetitions",
          "type": "integer"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "warmup_runs": {
          "minimum": 0,
          "title": "Warmup Runs",
          "type": "integer"
        },
        "workload_id": {
          "minLength": 1,
          "title": "Workload Id",
          "type": "string"
        }
      },
      "required": [
        "workload_id",
        "environment_id",
        "repetitions",
        "warmup_runs",
        "concurrency",
        "cache_state"
      ],
      "title": "WorkloadContract",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_type": {
      "const": "WorkloadIdentity",
      "default": "WorkloadIdentity",
      "title": "Artifact Type",
      "type": "string"
    },
    "case_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "content_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Digest",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "execution": {
      "anyOf": [
        {
          "$ref": "#/$defs/ComposeExecutionContract"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "extensions": {
      "additionalProperties": true,
      "title": "Extensions",
      "type": "object"
    },
    "missing_fields": {
      "items": {
        "type": "string"
      },
      "title": "Missing Fields",
      "type": "array"
    },
    "parent_digests": {
      "items": {
        "type": "string"
      },
      "title": "Parent Digests",
      "type": "array"
    },
    "policy_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Policy Versions",
      "type": "object"
    },
    "producer": {
      "$ref": "#/$defs/ProducerIdentity"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    },
    "workload": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkloadContract"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "artifact_id",
    "tenant_id",
    "case_id",
    "created_at",
    "producer",
    "content_digest"
  ],
  "title": "WorkloadIdentity",
  "type": "object"
}
