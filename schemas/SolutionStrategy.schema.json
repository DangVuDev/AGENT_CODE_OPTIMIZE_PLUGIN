{
  "$defs": {
    "CriterionImpact": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "enum": [
            "measured",
            "forecast"
          ],
          "title": "Basis",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "criterion_id": {
          "minLength": 1,
          "title": "Criterion Id",
          "type": "string"
        },
        "direction": {
          "enum": [
            "improves",
            "worsens",
            "neutral",
            "unknown"
          ],
          "title": "Direction",
          "type": "string"
        },
        "magnitude": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Magnitude"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "criterion_id",
        "direction",
        "confidence",
        "basis"
      ],
      "title": "CriterionImpact",
      "type": "object"
    },
    "ExperimentPhaseTemplate": {
      "additionalProperties": false,
      "properties": {
        "expected_observations": {
          "items": {
            "type": "string"
          },
          "title": "Expected Observations",
          "type": "array"
        },
        "phase_id": {
          "minLength": 1,
          "title": "Phase Id",
          "type": "string"
        },
        "phase_kind": {
          "enum": [
            "diagnostic",
            "implementation"
          ],
          "title": "Phase Kind",
          "type": "string"
        },
        "risk_factors": {
          "items": {
            "type": "string"
          },
          "title": "Risk Factors",
          "type": "array"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "treatment": {
          "$ref": "#/$defs/Treatment"
        }
      },
      "required": [
        "phase_id",
        "sequence",
        "phase_kind",
        "treatment"
      ],
      "title": "ExperimentPhaseTemplate",
      "type": "object"
    },
    "ImpactAssessment": {
      "additionalProperties": false,
      "properties": {
        "assessment_id": {
          "minLength": 1,
          "title": "Assessment Id",
          "type": "string"
        },
        "criterion_impacts": {
          "items": {
            "$ref": "#/$defs/CriterionImpact"
          },
          "minItems": 1,
          "title": "Criterion Impacts",
          "type": "array"
