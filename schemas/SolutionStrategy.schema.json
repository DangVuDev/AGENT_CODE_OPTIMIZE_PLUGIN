      },
      "required": [
        "assessment_id",
        "strategy_id",
        "criterion_impacts"
      ],
      "title": "ImpactAssessment",
      "type": "object"
    },
    "RiskAssessment": {
      "additionalProperties": false,
      "properties": {
        "assessment_id": {
          "minLength": 1,
          "title": "Assessment Id",
          "type": "string"
