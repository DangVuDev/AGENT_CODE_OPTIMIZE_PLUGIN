        "risk_tier": {
          "enum": [
            "experiment_config",
            "prompt",
            "code",
            "architecture"
          ],
          "title": "Risk Tier",
          "type": "string"
        },
        "security_impact": {
          "title": "Security Impact",
          "type": "boolean"
        },
        "strategy_id": {
          "minLength": 1,
          "title": "Strategy Id",
          "type": "string"
        },
        "uncertainty": {
          "maximum": 1,
          "minimum": 0,
          "title": "Uncertainty",
          "type": "number"
        }
      },
      "required": [
        "assessment_id",
        "strategy_id",
        "risk_tier",
        "blast_radius",
        "reversibility",
        "uncertainty",
        "migration_impact",
        "security_impact"
      ],
      "title": "RiskAssessment",
      "type": "object"
    },
    "RollbackPlan": {
      "additionalProperties": false,
