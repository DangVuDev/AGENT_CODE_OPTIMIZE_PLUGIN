{
  "$defs": {
    "ApprovalBinding": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "actor_role": {
          "minLength": 1,
          "title": "Actor Role",
          "type": "string"
        },
        "approval_id": {
          "minLength": 1,
          "title": "Approval Id",
          "type": "string"
        },
        "artifact_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Artifact Digest",
          "type": "string"
        },
        "decision": {
          "enum": [
            "approve",
            "reject"
          ],
          "title": "Decision",
          "type": "string"
        },
        "policy_version": {
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        }
      },
      "required": [
        "approval_id",
        "actor_id",
        "actor_role",
        "decision",
        "artifact_digest",
        "policy_version"
      ],
      "title": "ApprovalBinding",
      "type": "object"
    },
    "ComposeExecutionContract": {
      "additionalProperties": false,
      "description": "Immutable A1-to-A2 handoff for isolated product evaluation.",
      "properties": {
        "application_services": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Application Services",
          "type": "array"
        },
        "cleanup_timeout_seconds": {
          "default": 60,
          "exclusiveMinimum": 0,
          "maximum": 600,
          "title": "Cleanup Timeout Seconds",
          "type": "integer"
        },
        "compose_file": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Compose File",
          "type": "string"
        },
        "evaluations": {
          "items": {
            "$ref": "#/$defs/EvaluationSpec"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Evaluations",
          "type": "array"
        },
        "startup_timeout_seconds": {
          "default": 180,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Startup Timeout Seconds",
          "type": "integer"
        }
      },
      "required": [
        "compose_file",
        "evaluations"
      ],
      "title": "ComposeExecutionContract",
      "type": "object"
    },
    "ContainerCommandSpec": {
      "additionalProperties": false,
      "description": "One repository-owned command executed inside a Compose service.",
      "properties": {
        "argv": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Argv",
          "type": "array"
        },
        "service": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Service",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 300,
          "exclusiveMinimum": 0,
          "maximum": 86400,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "working_directory": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Working Directory"
        }
      },
      "required": [
        "service",
        "argv"
      ],
      "title": "ContainerCommandSpec",
      "type": "object"
    },
    "Criterion": {
      "additionalProperties": false,
      "properties": {
        "acceptance_operator": {
          "default": "lte",
          "enum": [
            "lt",
            "lte",
            "eq",
            "gte",
            "gt"
          ],
          "title": "Acceptance Operator",
          "type": "string"
        },
        "aggregation": {
          "default": "mean",
          "enum": [
            "mean",
            "p50",
            "p95",
            "p99",
            "sum",
            "rate",
            "maximum",
            "verdict"
          ],
          "title": "Aggregation",
          "type": "string"
        },
        "criterion_id": {
          "minLength": 1,
          "title": "Criterion Id",
          "type": "string"
        },
        "direction": {
          "enum": [
            "minimize",
            "maximize",
            "target"
          ],
          "title": "Direction",
          "type": "string"
        },
        "metric_id": {
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "metric_schema_version": {
          "default": "1.0",
          "minLength": 1,
          "title": "Metric Schema Version",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "number"
        },
        "tolerance": {
          "default": 0,
          "minimum": 0,
          "title": "Tolerance",
          "type": "number"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "weight": {
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "criterion_id",
        "metric_id",
        "direction",
        "target",
        "unit",
        "weight"
      ],
      "title": "Criterion",
      "type": "object"
    },
    "EvaluationSpec": {
      "additionalProperties": false,
      "description": "Repeatable evaluator and the metric names it promises to emit.",
      "properties": {
        "command": {
          "$ref": "#/$defs/ContainerCommandSpec"
        },
        "evaluation_id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Evaluation Id",
          "type": "string"
        },
        "expected_metric_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Expected Metric Ids",
          "type": "array",
          "uniqueItems": true
        },
        "repetitions": {
          "default": 1,
          "maximum": 100,
          "minimum": 1,
          "title": "Repetitions",
          "type": "integer"
        },
        "warmup_runs": {
          "default": 0,
          "maximum": 50,
          "minimum": 0,
          "title": "Warmup Runs",
          "type": "integer"
        }
      },
      "required": [
        "evaluation_id",
        "command",
        "expected_metric_ids"
      ],
      "title": "EvaluationSpec",
      "type": "object"
    },
    "EvidenceRequirement": {
      "additionalProperties": false,
      "properties": {
        "accepted_source_types": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Accepted Source Types",
          "type": "array",
          "uniqueItems": true
        },
        "aggregation": {
          "default": "mean",
          "enum": [
            "mean",
            "p50",
            "p95",
            "p99",
            "sum",
            "rate",
            "maximum",
            "verdict"
          ],
          "title": "Aggregation",
          "type": "string"
        },
        "canonical_unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Unit"
        },
        "criterion_id": {
          "title": "Criterion Id",
          "type": "string"
        },
        "freshness_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Freshness Seconds"
        },
        "mandatory": {
          "default": true,
          "title": "Mandatory",
          "type": "boolean"
        },
        "metric_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric Id"
        },
        "minimum_samples": {
          "minimum": 1,
          "title": "Minimum Samples",
          "type": "integer"
        },
        "minimum_trust_level": {
          "default": "verified",
          "enum": [
            "unverified",
            "verified",
            "attested"
          ],
          "title": "Minimum Trust Level",
          "type": "string"
        },
        "required_dimensions": {
          "items": {
            "type": "string"
          },
          "title": "Required Dimensions",
          "type": "array",
          "uniqueItems": true
        },
        "requirement_id": {
          "minLength": 1,
          "title": "Requirement Id",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "criterion_id",
        "accepted_source_types",
        "minimum_samples"
      ],
      "title": "EvidenceRequirement",
      "type": "object"
    },
    "ExecutionBudget": {
      "additionalProperties": false,
      "properties": {
        "allowed_analyzers": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Analyzers",
          "type": "array",
          "uniqueItems": true
        },
        "deadline_seconds": {
          "exclusiveMinimum": 0,
          "title": "Deadline Seconds",
          "type": "integer"
        },
        "maximum_concurrency": {
          "default": 1,
          "maximum": 256,
          "minimum": 1,
          "title": "Maximum Concurrency",
          "type": "integer"
        },
        "maximum_model_tokens": {
          "minimum": 0,
          "title": "Maximum Model Tokens",
          "type": "integer"
        },
        "maximum_retries": {
          "default": 1,
          "maximum": 10,
          "minimum": 0,
          "title": "Maximum Retries",
          "type": "integer"
        },
        "maximum_storage_bytes": {
          "minimum": 0,
          "title": "Maximum Storage Bytes",
          "type": "integer"
        },
        "maximum_worker_seconds": {
          "minimum": 0,
          "title": "Maximum Worker Seconds",
          "type": "integer"
        },
        "priority": {
          "default": "normal",
          "enum": [
            "low",
            "normal",
            "high"
          ],
          "title": "Priority",
          "type": "string"
        }
      },
      "required": [
        "deadline_seconds",
        "maximum_worker_seconds",
        "maximum_model_tokens",
        "maximum_storage_bytes"
      ],
      "title": "ExecutionBudget",
      "type": "object"
    },
    "FeatureScope": {
      "additionalProperties": false,
      "properties": {
        "alternative_paths": {
          "items": {
            "type": "string"
          },
          "title": "Alternative Paths",
          "type": "array"
        },
        "artifact_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "const": "FeatureScope",
          "default": "FeatureScope",
          "title": "Artifact Type",
          "type": "string"
        },
        "case_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "exclude_paths": {
          "items": {
            "type": "string"
          },
          "title": "Exclude Paths",
          "type": "array"
        },
        "extensions": {
          "additionalProperties": true,
          "title": "Extensions",
          "type": "object"
        },
        "feature_id": {
          "minLength": 1,
          "title": "Feature Id",
          "type": "string"
        },
        "include_paths": {
          "items": {
            "type": "string"
          },
          "title": "Include Paths",
          "type": "array"
        },
        "parent_digests": {
          "items": {
            "type": "string"
          },
          "title": "Parent Digests",
          "type": "array"
        },
        "policy_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Policy Versions",
          "type": "object"
        },
        "producer": {
          "$ref": "#/$defs/ProducerIdentity"
        },
        "rationale": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "supporting_paths": {
          "items": {
            "type": "string"
          },
          "title": "Supporting Paths",
          "type": "array"
        },
        "tenant_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "tenant_id",
        "case_id",
        "created_at",
        "producer",
        "content_digest",
        "feature_id",
        "confidence",
        "rationale"
      ],
      "title": "FeatureScope",
      "type": "object"
    },
    "Guardrail": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "default": "correctness",
          "enum": [
            "correctness",
            "security",
            "reliability",
            "cost",
            "quality"
          ],
          "title": "Category",
          "type": "string"
        },
        "guardrail_id": {
          "minLength": 1,
          "title": "Guardrail Id",
          "type": "string"
        },
        "mandatory": {
          "default": true,
          "title": "Mandatory",
          "type": "boolean"
        },
        "metric_id": {
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "metric_schema_version": {
          "default": "1.0",
          "minLength": 1,
          "title": "Metric Schema Version",
          "type": "string"
        },
        "operator": {
          "enum": [
            "lt",
            "lte",
            "eq",
            "gte",
            "gt"
          ],
          "title": "Operator",
          "type": "string"
        },
        "severity": {
          "default": "blocking",
          "enum": [
            "warning",
            "blocking"
          ],
          "title": "Severity",
          "type": "string"
        },
        "threshold": {
          "title": "Threshold",
          "type": "number"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "guardrail_id",
        "metric_id",
        "operator",
        "threshold",
        "unit"
      ],
      "title": "Guardrail",
      "type": "object"
    },
    "Objective": {
      "additionalProperties": false,
      "properties": {
        "feature_id": {
          "minLength": 1,
          "title": "Feature Id",
          "type": "string"
        },
        "statement": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "statement",
        "feature_id"
      ],
      "title": "Objective",
      "type": "object"
    },
    "Origin": {
      "enum": [
        "manual",
        "automatic"
      ],
      "title": "Origin",
      "type": "string"
    },
    "ProducerIdentity": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ProducerIdentity",
      "type": "object"
    },
    "ScopeProfile": {
      "enum": [
        "local_sandbox",
        "connected_production"
      ],
      "title": "ScopeProfile",
      "type": "string"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "allowed_root_id": {
          "minLength": 1,
          "title": "Allowed Root Id",
          "type": "string"
        },
        "locator": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "relative_path": {
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "repository_id": {
          "minLength": 1,
          "title": "Repository Id",
          "type": "string"
        },
        "requested_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requested Revision"
        },
        "source_kind": {
          "default": "local_directory",
          "minLength": 1,
          "title": "Source Kind",
          "type": "string"
        }
      },
      "required": [
        "repository_id",
        "allowed_root_id",
        "relative_path"
      ],
      "title": "SourceReference",
      "type": "object"
    },
    "WorkloadContract": {
      "additionalProperties": false,
      "properties": {
        "cache_state": {
          "minLength": 1,
          "title": "Cache State",
          "type": "string"
        },
        "command_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command Id"
        },
        "concurrency": {
          "minimum": 1,
          "title": "Concurrency",
          "type": "integer"
        },
        "dataset_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Digest"
        },
        "dataset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Id"
        },
        "environment_id": {
          "minLength": 1,
          "title": "Environment Id",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "protocol_version": {
          "default": "1.0",
          "minLength": 1,
          "title": "Protocol Version",
          "type": "string"
        },
        "repetitions": {
          "minimum": 1,
          "title": "Repetitions",
          "type": "integer"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "warmup_runs": {
          "minimum": 0,
          "title": "Warmup Runs",
          "type": "integer"
        },
        "workload_id": {
          "minLength": 1,
          "title": "Workload Id",
          "type": "string"
        }
      },
      "required": [
        "workload_id",
        "environment_id",
        "repetitions",
        "warmup_runs",
        "concurrency",
        "cache_state"
      ],
      "title": "WorkloadContract",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approval": {
      "$ref": "#/$defs/ApprovalBinding"
    },
    "artifact_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_type": {
      "const": "OptimizationRequest",
      "default": "OptimizationRequest",
      "title": "Artifact Type",
      "type": "string"
    },
    "budget": {
      "$ref": "#/$defs/ExecutionBudget"
    },
    "case_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "content_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Digest",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "criteria": {
      "items": {
        "$ref": "#/$defs/Criterion"
      },
      "minItems": 1,
      "title": "Criteria",
      "type": "array"
    },
    "evidence_requirements": {
      "items": {
        "$ref": "#/$defs/EvidenceRequirement"
      },
      "minItems": 1,
      "title": "Evidence Requirements",
      "type": "array"
    },
    "execution": {
      "anyOf": [
        {
          "$ref": "#/$defs/ComposeExecutionContract"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "extensions": {
      "additionalProperties": true,
      "title": "Extensions",
      "type": "object"
    },
    "feature_scope": {
      "anyOf": [
        {
          "$ref": "#/$defs/FeatureScope"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "guardrails": {
      "items": {
        "$ref": "#/$defs/Guardrail"
      },
      "title": "Guardrails",
      "type": "array"
    },
    "objective": {
      "$ref": "#/$defs/Objective"
    },
    "origin": {
      "$ref": "#/$defs/Origin"
    },
    "parent_digests": {
      "items": {
        "type": "string"
      },
      "title": "Parent Digests",
      "type": "array"
    },
    "policy_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Policy Versions",
      "type": "object"
    },
    "producer": {
      "$ref": "#/$defs/ProducerIdentity"
    },
    "request_fingerprint": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Request Fingerprint",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope_profile": {
      "$ref": "#/$defs/ScopeProfile"
    },
    "source": {
      "$ref": "#/$defs/SourceReference"
    },
    "tenant_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    },
    "workload": {
      "$ref": "#/$defs/WorkloadContract"
    }
  },
  "required": [
    "artifact_id",
    "tenant_id",
    "case_id",
    "created_at",
    "producer",
    "content_digest",
    "origin",
    "scope_profile",
    "source",
    "objective",
    "criteria",
    "workload",
    "evidence_requirements",
    "budget",
    "approval",
    "request_fingerprint"
  ],
  "title": "OptimizationRequest",
  "type": "object"
}
