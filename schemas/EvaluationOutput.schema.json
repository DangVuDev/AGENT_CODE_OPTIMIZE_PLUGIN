{
  "additionalProperties": false,
  "description": "The only accepted stdout payload from a product evaluator.",
  "properties": {
    "artifacts": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Artifacts",
      "type": "object"
    },
    "feature_id": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Feature Id",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "metrics": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "integer"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "minProperties": 1,
      "title": "Metrics",
      "type": "object"
    },
    "samples": {
      "additionalProperties": {
        "items": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": "array"
      },
      "title": "Samples",
      "type": "object"
    },
    "schema_version": {
      "default": "1.0",
      "maxLength": 32,
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "feature_id",
    "metrics"
  ],
  "title": "EvaluationOutput",
  "type": "object"
}
