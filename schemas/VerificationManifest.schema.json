{
  "$defs": {
    "ProducerIdentity": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ProducerIdentity",
      "type": "object"
    },
    "RepositoryCommand": {
      "additionalProperties": false,
      "properties": {
        "argv": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Argv",
          "type": "array"
        },
        "command_id": {
          "title": "Command Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "build",
            "unit",
            "integration",
            "benchmark",
            "lint",
            "type",
            "security"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "enum": [
            "pyproject_toml",
            "ci_config",
            "llm_suggested"
          ],
          "title": "Source",
          "type": "string"
        },
        "working_directory": {
          "title": "Working Directory",
          "type": "string"
        }
      },
      "required": [
        "command_id",
        "argv",
        "working_directory",
        "kind",
        "source"
      ],
      "title": "RepositoryCommand",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A2.31 output: only repository-owned commands the snapshot can justify.\n\nDistinct from `RepositoryManifest.commands` (A2.30), which stays empty\nuntil this node resolves argv against real, detected tool configuration.",
  "properties": {
    "artifact_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_type": {
      "const": "VerificationManifest",
      "default": "VerificationManifest",
      "title": "Artifact Type",
      "type": "string"
    },
    "case_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "commands": {
      "items": {
        "$ref": "#/$defs/RepositoryCommand"
      },
      "title": "Commands",
      "type": "array"
    },
    "content_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Digest",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "extensions": {
      "additionalProperties": true,
      "title": "Extensions",
      "type": "object"
    },
    "parent_digests": {
      "items": {
        "type": "string"
      },
      "title": "Parent Digests",
      "type": "array"
    },
    "policy_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Policy Versions",
      "type": "object"
    },
    "producer": {
      "$ref": "#/$defs/ProducerIdentity"
    },
    "rejected_commands": {
      "items": {
        "type": "string"
      },
      "title": "Rejected Commands",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "artifact_id",
    "tenant_id",
    "case_id",
    "created_at",
    "producer",
    "content_digest"
  ],
  "title": "VerificationManifest",
  "type": "object"
}
