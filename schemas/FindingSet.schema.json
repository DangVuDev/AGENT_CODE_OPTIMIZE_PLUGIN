{
  "$defs": {
    "AnalyzerObservation": {
      "additionalProperties": false,
      "properties": {
        "analyzer": {
          "minLength": 1,
          "title": "Analyzer",
          "type": "string"
        },
        "analyzer_version": {
          "minLength": 1,
          "title": "Analyzer Version",
          "type": "string"
        },
        "coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Coverage",
          "type": "number"
        },
        "description": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "files": {
          "items": {
            "type": "string"
          },
          "title": "Files",
          "type": "array"
        },
        "observation_id": {
          "minLength": 1,
          "title": "Observation Id",
          "type": "string"
        },
        "polarity": {
          "enum": [
            "positive",
            "negative"
          ],
          "title": "Polarity",
          "type": "string"
        },
        "problem_signal_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Problem Signal Ids",
          "type": "array"
        },
        "source": {
          "enum": [
            "syntax",
            "semantic",
            "domain",
            "runtime"
          ],
          "title": "Source",
          "type": "string"
        },
        "symbols": {
          "items": {
            "type": "string"
          },
          "title": "Symbols",
          "type": "array"
        }
      },
      "required": [
        "observation_id",
        "source",
        "analyzer",
        "analyzer_version",
        "problem_signal_ids",
        "description",
        "polarity",
        "coverage"
      ],
      "title": "AnalyzerObservation",
      "type": "object"
    },
    "CitationResolutionEntry": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "in_scope": {
          "title": "In Scope",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "resolved": {
          "title": "Resolved",
          "type": "boolean"
        },
        "supports_statement": {
          "title": "Supports Statement",
          "type": "boolean"
        }
      },
      "required": [
        "evidence_id",
        "resolved",
        "in_scope",
        "supports_statement"
      ],
      "title": "CitationResolutionEntry",
      "type": "object"
    },
    "CitationResolutionReport": {
      "additionalProperties": false,
      "properties": {
        "all_resolved": {
          "title": "All Resolved",
          "type": "boolean"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/CitationResolutionEntry"
          },
          "minItems": 1,
          "title": "Entries",
          "type": "array"
        },
        "finding_id": {
          "minLength": 1,
          "title": "Finding Id",
          "type": "string"
        },
        "report_id": {
          "minLength": 1,
          "title": "Report Id",
          "type": "string"
        }
      },
      "required": [
        "report_id",
        "finding_id",
        "entries",
        "all_resolved"
      ],
      "title": "CitationResolutionReport",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "analyzer_coverage": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Analyzer Coverage",
          "type": "object"
        },
        "causal_claim": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Causal Claim",
          "type": "string"
        },
        "claim_type": {
          "enum": [
            "observation",
            "hypothesis",
            "verified_cause"
          ],
          "title": "Claim Type",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "counterevidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Counterevidence Ids",
          "type": "array"
        },
        "finding_id": {
          "minLength": 1,
          "title": "Finding Id",
          "type": "string"
        },
        "judgement": {
          "$ref": "#/$defs/FindingJudgement"
        },
        "problem_signal_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Problem Signal Ids",
          "type": "array"
        },
        "runtime_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime Path"
        },
        "scope_files": {
          "items": {
            "type": "string"
          },
          "title": "Scope Files",
          "type": "array"
        },
        "scope_symbols": {
          "items": {
            "type": "string"
          },
          "title": "Scope Symbols",
          "type": "array"
        },
        "supporting_evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supporting Evidence Ids",
          "type": "array"
        },
        "symptom": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Symptom",
          "type": "string"
        },
        "trust_level": {
          "$ref": "#/$defs/TrustLevel"
        },
        "unknowns": {
          "items": {
            "type": "string"
          },
          "title": "Unknowns",
          "type": "array"
        }
      },
      "required": [
        "finding_id",
        "problem_signal_ids",
        "claim_type",
        "symptom",
        "causal_claim",
        "supporting_evidence_ids",
        "confidence",
        "trust_level",
        "judgement"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FindingJudgement": {
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "minLength": 1,
          "title": "Finding Id",
          "type": "string"
        },
        "judge_id": {
          "minLength": 1,
          "title": "Judge Id",
          "type": "string"
        },
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "model_version": {
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Reasons",
          "type": "array"
        },
        "verdict": {
          "enum": [
            "accept",
            "reject"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "judge_id",
        "finding_id",
        "verdict",
        "reasons",
        "model_id",
        "model_version"
      ],
      "title": "FindingJudgement",
      "type": "object"
    },
    "ProducerIdentity": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ProducerIdentity",
      "type": "object"
    },
    "TrustLevel": {
      "enum": [
        "T0",
        "T1",
        "T2",
        "T3",
        "T4"
      ],
      "title": "TrustLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_type": {
      "const": "FindingSet",
      "default": "FindingSet",
      "title": "Artifact Type",
      "type": "string"
    },
    "case_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "citation_reports": {
      "items": {
        "$ref": "#/$defs/CitationResolutionReport"
      },
      "title": "Citation Reports",
      "type": "array"
    },
    "content_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Digest",
      "type": "string"
    },
    "coverage_gaps": {
      "items": {
        "type": "string"
      },
      "title": "Coverage Gaps",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "evidence_bundle_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Evidence Bundle Digest",
      "type": "string"
    },
    "extensions": {
      "additionalProperties": true,
      "title": "Extensions",
      "type": "object"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "minItems": 1,
      "title": "Findings",
      "type": "array"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/AnalyzerObservation"
      },
      "title": "Observations",
      "type": "array"
    },
    "parent_digests": {
      "items": {
        "type": "string"
      },
      "title": "Parent Digests",
      "type": "array"
    },
    "policy_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Policy Versions",
      "type": "object"
    },
    "producer": {
      "$ref": "#/$defs/ProducerIdentity"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "artifact_id",
    "tenant_id",
    "case_id",
    "created_at",
    "producer",
    "content_digest",
    "evidence_bundle_digest",
    "findings"
  ],
  "title": "FindingSet",
  "type": "object"
}
