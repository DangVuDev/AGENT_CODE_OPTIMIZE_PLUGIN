      "uniqueItems": true
    },
    "context_id": {
      "minLength": 1,
      "title": "Context Id",
      "type": "string"
    },
    "maximum_bytes": {
      "exclusiveMinimum": 0,
      "title": "Maximum Bytes",
      "type": "integer"
    },
    "redaction_profile_id": {
      "minLength": 1,
      "title": "Redaction Profile Id",
      "type": "string"
    }
